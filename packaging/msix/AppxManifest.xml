<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for the Microsoft Store build. scripts/make-msix.ps1 replaces the
  double-underscore tokens. The three identity values must be copied verbatim from
  Partner Center: Product management > Product identity.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__IDENTITY_PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PecoFence</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Group your desktop icons into glass fences on Windows 11.</Description>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
    <Resource Language="zh-TW" />
    <Resource Language="ja" />
    <Resource Language="ko" />
    <Resource Language="de" />
    <Resource Language="fr" />
    <Resource Language="es" />
    <Resource Language="pt-BR" />
    <Resource Language="ru" />
  </Resources>

  <Dependencies>
    <!-- Windows 11 only (build 22000). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <!-- Win32 desktop app: shell hooks, desktop icon management, tray icon. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="PecoFence" Executable="pecofence.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="PecoFence"
        Description="Group your desktop icons into glass fences on Windows 11."
        BackgroundColor="#4768DE"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png"
          ShortName="PecoFence" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Run at logon. Users control this in Settings > Apps > Startup or Task Manager. -->
        <desktop:Extension Category="windows.startupTask" Executable="pecofence.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PecoFenceStartup" Enabled="true" DisplayName="PecoFence" />
        </desktop:Extension>
        <!-- `pecofence-cli` on PATH for terminals and coding agents; users can turn the alias
             off under Settings > Apps > Advanced app settings > App execution aliases. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="pecofence-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="pecofence-cli.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
